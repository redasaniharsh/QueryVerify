# --- LLM provider: keep this as "ollama" during development ---
# Switch to "openai" or "anthropic" only when you deploy / push a hosted demo.
LLM_PROVIDER=ollama

# --- Local models (used when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_SQL_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_REASONING_MODEL=qwen2.5:3b-instruct

# --- Cloud models (only needed when LLM_PROVIDER=openai / anthropic) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLOUD_SQL_MODEL=gpt-4o-mini

# --- Database: SQL Server is THE database. SQLite is used only for internal
# per-session CSV uploads and local chat history, never for the sample set. ---
# Local SQL Server Express (Windows auth / trusted connection):
DATABASE_URL=mssql+pyodbc://.\SQLEXPRESS/QueryVerifyTest?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# SQL auth (needed from Docker/Linux) against a fixed TCP port:
# DATABASE_URL=mssql+pyodbc://sa:<password>@<host>:1433/QueryVerifyTest?driver=ODBC+Driver+17+for+SQL+Server

# --- Agent behavior ---
MAX_REPAIR_ATTEMPTS=3
SELF_CONSISTENCY_SAMPLES=3
# Cap on rows returned to the UI per query; oversized results are truncated
# with a clear notice instead of hanging or flooding the UI.
QV_MAX_RESULT_ROWS=25000
