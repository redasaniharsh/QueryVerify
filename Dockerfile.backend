# Backend container: FastAPI + SQL agents. Ollama is NOT containerized — it
# runs natively on the host and is reached via http://host.docker.internal:11434
# (set on the backend service in docker-compose.yml).
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ app/
COPY scripts/ scripts/
COPY data/ data/

EXPOSE 8000

# database_url defaults to sqlite:///./data/sample.db (relative to /app), so the
# mounted ./data bind mount at /app/data is where SQLite lives.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]